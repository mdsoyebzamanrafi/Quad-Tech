PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/ecommerce-app
JWT_SECRET=replace_with_a_long_random_secret

# Production/staging auth should keep reCAPTCHA enabled.
RECAPTCHA_SECRET_KEY=your_google_recaptcha_secret_key

# Local development only: set to true only with NODE_ENV=development.
# Production ignores this unless NODE_ENV is incorrectly set to development.
DISABLE_RECAPTCHA=false

GOOGLE_CLIENT_ID=your_google_client_id

# Optional first super-admin bootstrap. Used by npm run bootstrap:superadmin
# and server startup when no active super_admin exists.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change_this_local_password
SUPER_ADMIN_NAME=Initial Super Admin
SUPER_ADMIN_PHONE=

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="Quad Tech Security"
SMTP_FROM_EMAIL=
