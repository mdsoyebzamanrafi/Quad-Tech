PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/ecommerce-app
JWT_SECRET=replace_with_a_long_random_secret

# Production/staging auth should keep reCAPTCHA enabled.
RECAPTCHA_SECRET_KEY=your_google_recaptcha_secret_key

# Local development only. CAPTCHA bypass is only honored for
# NODE_ENV=development/dev/local or NODE_ENV=test.
CAPTCHA_ENABLED=true

# Legacy alias kept for backward compatibility.
DISABLE_RECAPTCHA=false

GOOGLE_CLIENT_ID=your_google_client_id

# Optional first super-admin bootstrap. Used by npm run bootstrap:superadmin
# and server startup when no active super_admin exists.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change_this_local_password
SUPER_ADMIN_NAME=Initial Super Admin
SUPER_ADMIN_PHONE=

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="Quad Tech Security"
SMTP_FROM_EMAIL=

# Ollama prompt recommendations
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_MS=30000

# Optional if your ngrok tunnel is protected with Basic Auth.
OLLAMA_BASIC_AUTH_USER=
OLLAMA_BASIC_AUTH_PASS=

GEMINI_API_KEY=your_gemini_api_key
GEMINI_VISION_MODEL=gemini-2.5-flash

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUD_CLOSET_UPLOAD_LIMIT=2
