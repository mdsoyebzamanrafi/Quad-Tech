VITE_API_URL=http://localhost:5000
VITE_GOOGLE_CLIENT_ID=your_google_client_id
VITE_RECAPTCHA_SITE_KEY=your_google_recaptcha_site_key

# Local development only. The app checks import.meta.env.DEV, so production
# builds ignore this flag.
VITE_CAPTCHA_ENABLED=true

# Legacy alias kept for backward compatibility.
VITE_DISABLE_RECAPTCHA=false
